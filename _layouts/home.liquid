---
layout: default
---

<!-- Include network background script -->
<script src="{{ '/assets/js/network-background.js' | relative_url }}"></script>

<div class="home-container">
  <div class="home-content">
    <h1 class="home-title">
      <span class="text-primary">Hello,</span> I'm {{ site.first_name }}
    </h1>
    <h2 class="home-subtitle">
      Tech • Business • Finance • Law
    </h2>
    <h4 class="home-subtitle" style="font-size: 16px;">
      Software Engineer • Data Scientist • Quantitative Finance Enthusiast
    </h4>
    <p class="home-description">
      I build scalable systems, AI-driven applications, and automated trading platforms that bridge the gap between technical excellence and business value. 
      Currently a <strong>Data Analyst</strong> at Handshake AI, I'm simultaneously launching products—from fitness platforms to algorithmic trading systems—while building the next generation of fintech solutions and personal business ventures.
    </p>
    <div class="home-cta">
      <a href="{{ '/projects/' | relative_url }}" class="btn btn-primary">View My Work</a>
      <a href="{{ '/blog/' | relative_url }}" class="btn btn-outline-primary">Read My Blog</a>
    </div>

    <div class="home-badges">
      <span class="badge-item">AWS CCP</span>
      <span class="badge-item">Bloomberg BMC</span>
      <span class="badge-item">Data Science</span>
      <span class="badge-item">Machine Learning</span>
      <span class="badge-item">Quantitative Finance</span>
    </div>
  </div>

  <div class="home-featured">
    <h3 class="featured-heading">Featured Projects</h3>
    <div class="featured-grid">
      {% assign featured = site.projects | where: "featured", true | sort: "importance" %}
      {% for project in featured %}
        <a href="{{ project.url | relative_url }}" class="featured-card">
          <div class="featured-img">
            {% if project.img %}
              <img src="{{ project.img | relative_url }}" alt="{{ project.title }}" loading="lazy">
            {% endif %}
          </div>
          <div class="featured-body">
            <h5>{{ project.title }}</h5>
            <p>{{ project.description | truncate: 110 }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>
