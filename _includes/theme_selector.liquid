<div class="theme-dropdown-container">
  <button id="theme-dropdown-toggle" class="theme-dropdown-toggle" aria-haspopup="listbox" aria-expanded="false" title="Change theme">
    <i class="ti ti-sun-moon" id="theme-dropdown-icon"></i>
    <span id="theme-dropdown-label">System</span>
    <i class="fas fa-chevron-down theme-dropdown-chevron"></i>
  </button>
  <ul class="theme-dropdown-menu" role="listbox" aria-label="Theme">
    <li role="option" data-theme-value="light" tabindex="0" aria-label="Light mode">
      <i class="fas fa-sun"></i>
      <span>Light</span>
    </li>
    <li role="option" data-theme-value="dark" tabindex="0" aria-label="Dark mode">
      <i class="fas fa-moon"></i>
      <span>Dark</span>
    </li>
    <li role="option" data-theme-value="system" tabindex="0" aria-label="System preference">
      <i class="fas fa-desktop"></i>
      <span>System</span>
    </li>
  </ul>
</div>
